#!/usr/bin/env bash
# paperclip-secrets-canary — rendered by the Ansible role `paperclip` (layer2) and run as
# `ExecStartPre=` of paperclip.service.
#
# Purpose: convert a broken secret path from a failure nobody notices (the TD-091 shape:
# `gpg: public key decryption failed: Operation cancelled` at the *first push*, hours
# after the last successful start) into a service that refuses to start, with a message
# that names the defect.
#
# What it proves, in this order:
#   1. the agent store is initialised and its recipient list is exactly one key
#   2. the keyring holds exactly one secret key and it *is* that recipient — i.e. the key
#      is this container's own, not an operator key that leaked in
#   3. every entry the service needs decrypts — cold, with no pinentry, no session, no
#      warm cache (it runs inside the unit's environment)
#   4. an operator-only path is NOT readable: the scoping is real, not aspirational
#
# It never prints a value: values are only length-tested and discarded.
#
# Exit codes (chosen so a single journal line identifies the failure):
#   2 missing store   3 recipient list not scoped   4 key is not the container's own
#   5 required entry unreadable   6 scoping broken   7 not run in the service environment
#
# Implementation note: array length is read through `grep -c` instead of the shell's
# "number of elements" expansion, because that expansion starts with a character pair that
# opens a Jinja comment, and this file is a template.
set -uo pipefail

store_dir="{{ paperclip_gopass_store_path }}"
store="{{ paperclip_gopass_store }}"
{% set canary_entries = paperclip_gopass_entries | selectattr('canary', 'defined') | selectattr('canary') | map(attribute='as') | list %}

fail() {
	printf 'paperclip-secrets-canary: FATAL: %s\n' "$1" >&2
	exit "$2"
}

# Running it by hand is a supported diagnostic (RUNBOOK, "check the secret path"); outside
# the service environment it would silently inspect a different keyring and store.
[ -n "${GNUPGHOME:-}" ] || fail "GNUPGHOME is unset: run me through systemd, or as the service user with HOME and GNUPGHOME set to the service's" 7
[ -n "${HOME:-}" ] || fail "HOME is unset: run me through systemd, or with HOME set to the service's home" 7

id_file="${store_dir}/.gpg-id"
[ -s "$id_file" ] || fail "no recipient list at ${id_file}: the agent store was never initialised on this container" 2

recipients="$(grep -c -v '^[[:space:]]*$' "$id_file")"
[ "$recipients" -eq 1 ] || fail "the store's .gpg-id lists ${recipients} recipients; it must list only the container's key" 3
recipient="$(grep -v '^[[:space:]]*$' "$id_file" | head -n 1 | tr -d '[:space:]' | tr 'A-F' 'a-f' | sed 's/^0x//')"

# `sec` records, not `fpr` records: a key with an encryption subkey prints two
# fingerprints, and counting those would report two keys for one key.
secret_keys="$(gpg --batch --with-colons --list-secret-keys 2>/dev/null | awk -F: '$1 == "sec" { n++ } END { print n + 0 }')"
[ "$secret_keys" -eq 1 ] || fail "the keyring holds ${secret_keys} secret keys; it must hold exactly the container's own — a second key means the recipient scoping no longer describes what this container can open" 4
# The first `fpr` record is the primary key's; do NOT sort the fingerprint records first,
# because a key's encryption subkey has its own fingerprint and would win the sort,
# producing a mismatch against the store for a perfectly healthy keyring.
key="$(gpg --batch --with-colons --list-secret-keys 2>/dev/null | awk -F: '$1 == "fpr" { print $10; exit }' | tr 'A-F' 'a-f')"
[ "${recipient: -16}" = "${key: -16}" ] || fail "the store is encrypted to ...${recipient: -16} but the only secret key in the keyring is ...${key: -16}: restore the keyring, do not regenerate the key (a new key cannot open the existing store)" 4

for entry in {% for e in canary_entries %}"${store}/{{ e }}" {% endfor %}; do
	if ! value="$(gopass show -o "$entry" 2>/dev/null)" || [ -z "${value//[[:space:]]/}" ]; then
		fail "entry ${entry} did not decrypt with the container's own key (cold, no pinentry): the service would fail later, at the first use" 5
	fi
	unset value
done

if gopass show -o "{{ paperclip_canary_foreign_entry }}" >/dev/null 2>&1; then
	fail "an operator-store path ({{ paperclip_canary_foreign_entry }}) is readable: recipient scoping is broken and this container can open secrets it must not" 6
fi

printf 'paperclip-secrets-canary: ok — store ...%s scoped, %s entries decrypt cold, operator paths refused\n' \
	"${key: -16}" "{{ canary_entries | length }}"

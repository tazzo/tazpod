# Paperclip runtime environment — rendered by Ansible (role `paperclip`, layer2).
# Readable only by the service user (0600): it carries the database password and the
# application secrets, and the provisioning tasks source it — nothing is passed in argv.
# Rendered with `no_log: true`; never committed, never printed in a task diff.
NODE_ENV=production
PAPERCLIP_HOME={{ paperclip_home }}
PAPERCLIP_INSTANCE_ID={{ paperclip_instance_id }}
PAPERCLIP_DEPLOYMENT_MODE={{ paperclip_deployment_mode }}
PAPERCLIP_DEPLOYMENT_EXPOSURE={{ paperclip_deployment_exposure }}
PAPERCLIP_BIND={{ paperclip_bind }}
PAPERCLIP_PUBLIC_URL={{ paperclip_public_url }}
PAPERCLIP_ALLOWED_HOSTNAMES={{ paperclip_allowed_hostnames }}
PORT={{ paperclip_port }}
HOST={{ paperclip_host }}

# PAPERCLIP_SECRETS_MASTER_KEY_FILE is deliberately NOT set here. The unit sets it to
# `%d/master-key`, i.e. the systemd credential loaded from
# {{ paperclip_master_key_file }} — a copy that is readable only by this unit's user and
# is not inherited by unrelated processes of the same user. `EnvironmentFile=` overrides
# `Environment=`, so a path in this file would silently shadow the credential and defeat
# the pinning the design asks for (DESIGN §4).

# PostgreSQL: the existing external tazlab-db cluster, reached over the pinned LAN
# NodePort. The database is not created here — it *is* the company, and this container
# resumes against the same one (DESIGN §4).
# sslmode=require encrypts; the server's certificate carries only its in-cluster name, so
# hostname verification is not available from here (TD-085).
DATABASE_URL=postgres://{{ paperclip_db_user }}:{{ paperclip_env_secret_values['PAPERCLIP_DB_PASSWORD'] | urlencode }}@{{ paperclip_db_host }}:{{ paperclip_db_port }}/{{ paperclip_db_name }}?sslmode=require
DATABASE_MIGRATION_URL=postgres://{{ paperclip_db_user }}:{{ paperclip_env_secret_values['PAPERCLIP_DB_PASSWORD'] | urlencode }}@{{ paperclip_db_host }}:{{ paperclip_db_port }}/{{ paperclip_db_name }}?sslmode=require
DATABASE_PREPARED_STATEMENTS=true
DATABASE_POOL_MAX={{ paperclip_db_pool_max }}
DATABASE_IDLE_TIMEOUT_SECONDS=60
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_MAX_LIFETIME_SECONDS=3600
DATABASE_APPLICATION_NAME=paperclip
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# Application secrets. These must reach the new container *byte-identical*: the instance
# id and the agent-JWT derivation depend on them, and rotating one invalidates the agent
# credentials the company already holds (DESIGN §4). They are read from the agent store at
# provisioning time — never from `-e`, never from a file in the repository.
BETTER_AUTH_SECRET={{ paperclip_env_secret_values['BETTER_AUTH_SECRET'] }}
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET={{ paperclip_env_secret_values['PAPERCLIP_TOOL_ACTION_SIGNING_SECRET'] }}
PAPERCLIP_AGENT_JWT_SECRET={{ paperclip_env_secret_values['PAPERCLIP_AGENT_JWT_SECRET'] }}

# Agent CLI credentials, inherited by the adapter subprocesses (`pi_local` runs `pi`).
# OpenCode Go: provider `opencode-go`, model `deepseek-v4.1-flash`.
# These two stay in the container's environment on purpose: the CLI *inside* the container
# is what calls those endpoints, so there is no proxy to broker them through yet (PLAN
# T4b: "stays in the container's environment — the same pattern as today, same accepted
# exposure"). The GitHub push credential, the Proxmox token and the Vault SecretID are the
# ones that move to the egress proxy.
OPENCODE_API_KEY={{ paperclip_env_secret_values['OPENCODE_API_KEY'] }}

# Web search. `pi` has no native search and reaches Exa over the MCP server declared in
# `~/.pi/agent/mcp.json`, whose header interpolates this variable (it needs no `gopass` at
# connect time). `omp` supports Exa natively and reads the same variable.
EXA_API_KEY={{ paperclip_env_secret_values['EXA_API_KEY'] }}

# Agent git: the service uses the config rendered at /etc/paperclip/gitconfig, whose
# credential helper resolves the push token from the agent store at push time — cold, with
# no pinentry, because that store's key has no passphrase.
GIT_CONFIG_GLOBAL=/etc/paperclip/gitconfig

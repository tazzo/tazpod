[Unit]
Description=Paperclip (self-hosted agent control plane)
Documentation=https://github.com/paperclipai/paperclip
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User={{ paperclip_user }}
Group={{ paperclip_user }}
WorkingDirectory=/home/{{ paperclip_user }}
# Environment file (0600, owned by the service user) holding DATABASE_URL and the
# application secrets; it is sourced by the provisioning tasks, so no secret ever
# travels in argv or in a task environment.
EnvironmentFile=/etc/paperclip/paperclip.env
# The managed shim, not `npx`: an npx-started unit would report itself as an
# ephemeral install (losing `update`/`--rollback`) and re-resolve the payload from
# the registry at every start, defeating the version pin.
ExecStart=/home/{{ paperclip_user }}/.local/bin/paperclipai run
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

StandardOutput=journal
StandardError=journal
SyslogIdentifier=paperclip

# Resources: bounded well inside the container (2 cores / 8 GB shared with the
# agent workload). The V8 ceiling stays below MemoryMax on purpose.
Environment=NODE_OPTIONS=--max-old-space-size=2048
Environment=PATH=/usr/bin:/usr/local/bin:/bin
MemoryHigh=2G
MemoryMax=4G
CPUQuota=150%
TasksMax=512

# Hardening. The service runs as the operator user and its agents edit the
# repositories, so the writable surface is exactly the pet volume and that user's
# home; everything else stays read-only (ProtectSystem=strict). `NoNewPrivileges`
# and `PrivateDevices` stay on (no sudo from inside an agent), `ProtectHome` cannot
# be read-only here because pi writes sessions under ~/.pi.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=no
ReadWritePaths=/workspace /home/{{ paperclip_user }}
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
# AF_NETLINK is required: libuv enumerates the network interfaces with a netlink
# socket, and without it the process dies at startup with
# "uv_interface_addresses returned Unknown system error 97" (EAFNOSUPPORT).
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Match the operator shell's umask so files an agent writes in a repository are
# not unexpectedly unreadable to the rest of the tooling.
UMask=0022
# Deliberately NOT set: MemoryDenyWriteExecute (V8/JIT needs writable+executable
# pages) and SystemCallFilter (the Node/V8 syscall surface is not worth the risk).

[Install]
WantedBy=multi-user.target

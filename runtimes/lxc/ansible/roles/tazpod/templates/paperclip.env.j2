# Paperclip runtime environment — rendered by Ansible (role `tazpod`, `layer5-paperclip`).
# Readable only by the service user (0600): it carries the database password and the
# application secrets, and the provisioning tasks source it — nothing is passed in argv.
# Rendered with `no_log: true`; never committed, never printed in a task diff.
NODE_ENV=production
PAPERCLIP_HOME={{ paperclip_home }}
PAPERCLIP_INSTANCE_ID={{ paperclip_instance_id }}
PAPERCLIP_DEPLOYMENT_MODE={{ paperclip_deployment_mode }}
PAPERCLIP_DEPLOYMENT_EXPOSURE={{ paperclip_deployment_exposure }}
PAPERCLIP_BIND={{ paperclip_bind }}
PAPERCLIP_PUBLIC_URL={{ paperclip_public_url }}
PAPERCLIP_ALLOWED_HOSTNAMES={{ paperclip_allowed_hostnames }}
PORT={{ paperclip_port }}
HOST={{ paperclip_host }}

# PostgreSQL: the external tazlab-db cluster reached over the pinned LAN NodePort.
# sslmode=require encrypts; the server's certificate carries only its in-cluster
# name, so hostname verification is not available from here (TD-085).
DATABASE_URL=postgres://{{ paperclip_db_user }}:{{ paperclip_db_password | urlencode }}@{{ paperclip_db_host }}:{{ paperclip_db_port }}/{{ paperclip_db_name }}?sslmode=require
DATABASE_MIGRATION_URL=postgres://{{ paperclip_db_user }}:{{ paperclip_db_password | urlencode }}@{{ paperclip_db_host }}:{{ paperclip_db_port }}/{{ paperclip_db_name }}?sslmode=require
DATABASE_PREPARED_STATEMENTS=true
DATABASE_POOL_MAX={{ paperclip_db_pool_max }}
DATABASE_IDLE_TIMEOUT_SECONDS=60
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_MAX_LIFETIME_SECONDS=3600
DATABASE_APPLICATION_NAME=paperclip
PAPERCLIP_MIGRATION_AUTO_APPLY=true

# Secrets (gopass -> here at provisioning time; rotate via PLAN phase 2.4)
BETTER_AUTH_SECRET={{ paperclip_better_auth_secret }}
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET={{ paperclip_tool_action_secret }}
PAPERCLIP_AGENT_JWT_SECRET={{ paperclip_agent_jwt_secret }}

# Agent CLI credentials (inherited by the adapter subprocesses, e.g. pi_local).
# OpenCode Go: provider `opencode-go`, model `deepseek-v4.1-flash`.
OPENCODE_API_KEY={{ paperclip_opencode_key }}

# Web search: `pi`/`omp` support Exa natively and pick the provider up from this
# variable (no config change). The key is delivered from gopass at provisioning
# time and never written into a repository file.
EXA_API_KEY={{ paperclip_exa_key }}

# Agent git: the service uses the config below; its credential helper fetches the
# push token from gopass at push time, so no token is exported into the service or
# its child agent processes.
GIT_CONFIG_GLOBAL=/etc/paperclip/gitconfig

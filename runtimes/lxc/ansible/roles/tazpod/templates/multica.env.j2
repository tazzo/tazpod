# Multica daemon environment — rendered by Ansible (role `tazpod`, `layer6-multica`).
# Readable only by the service user (0600); systemd reads it as root for
# `EnvironmentFile=`, and the daemon inherits it into every agent CLI it spawns.
#
# What is deliberately NOT here: the server/app URL and the daemon token. This CLI
# has no environment variable for its own authentication — `MULTICA_TOKEN` is the
# per-task token the daemon *injects into an agent*, never its own credential
# (upstream `resolveAuth` reads the token only from the profile config) — so both
# live where `multica login` would have written them, in the 0600 profile config
# `{{ multica_cli_config_path }}`, which this layer renders from gopass.
#
# Rendered with `no_log: true`; never committed, never printed in a task diff.

# The daemon resolves `~/.multica` (profile config, daemon.log, daemon.pid) and the
# agent CLIs' own state (`~/.pi`, `~/.omp`) from HOME, and systemd does not give a
# system service a login environment: both are pinned here instead of assumed.
HOME={{ multica_user_home }}
PATH={{ multica_path }}

# Identity in the server's Runtimes view (the daemon id stays the hostname).
MULTICA_DAEMON_DEVICE_NAME={{ multica_device_name }}
MULTICA_AGENT_RUNTIME_NAME={{ multica_runtime_name }}

# One isolated directory per task, plus the shared bare-clone cache, on the pet
# volume: a container rebuild must not throw away the repository cache, and the
# daemon must never work inside the operator's own checkouts.
MULTICA_WORKSPACES_ROOT={{ multica_workspaces_root }}

# Resource plan for a 2-core / 8 GiB container shared with the interactive agents.
MULTICA_DAEMON_MAX_CONCURRENT_TASKS={{ multica_max_concurrent_tasks }}
MULTICA_DAEMON_POLL_INTERVAL={{ multica_poll_interval }}
MULTICA_DAEMON_HEARTBEAT_INTERVAL={{ multica_heartbeat_interval }}
MULTICA_AGENT_IDLE_WATCHDOG={{ multica_agent_idle_watchdog }}

# Self-update is off on purpose: the layer owns the pinned version + checksum, so the
# daemon must never phone GitHub Releases to replace its own binary behind Git.
# (Upstream already defaults this off for a self-hosted server; declaring it removes
# the doubt.)
MULTICA_DAEMON_AUTO_UPDATE=false

# Auto-reload is off for a systemd reason, not a policy one. When the binary on disk
# changes version, the daemon spawns a successor and exits; under `Type=exec` that
# leaves systemd supervising a dead main process while the successor keeps running
# outside the unit's accounting — the unit reads as stopped and the next start fails
# with "daemon is already running". Instead the layer replaces the binary and the
# `restart multica-daemon` handler reloads it, so the restart is a systemd event like
# every other service on this host.
MULTICA_DAEMON_AUTO_RELOAD=false

# Web search for the agent CLIs the daemon spawns (`omp` reads Exa natively). The
# operator's shell exports the same key from the same gopass entry; a systemd unit
# inherits no shell environment. Not a Multica secret: it is the lab's shared Exa key,
# delivered here at provisioning time for the same reason the Paperclip layer does it.
EXA_API_KEY={{ multica_exa_key }}

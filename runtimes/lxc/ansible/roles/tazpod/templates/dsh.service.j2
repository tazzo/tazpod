[Unit]
Description=DeepSeek Harness Web UI (dsh)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tazpod
Group=tazpod
WorkingDirectory=/workspace
Environment=HOME=/home/tazpod
Environment=DSH_TELEMETRY_DISABLED=1
Environment=PATH={{ dsh_bin.stdout | trim | dirname }}:/usr/local/bin:/usr/bin:/bin
ExecStart={{ dsh_bin.stdout | trim }} web --port {{ dsh_web_port }} --no-open
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/dsh-web.log
StandardError=append:/var/log/dsh-web.log

[Install]
WantedBy=multi-user.target

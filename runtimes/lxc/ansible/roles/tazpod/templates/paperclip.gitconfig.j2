# Git configuration used *only* by the Paperclip service (GIT_CONFIG_GLOBAL).
# It gives the agents a stable identity and fetches the push credential from
# gopass at push time (golden rule #1), so no token is exported into the service
# environment and none is ever written to a file or to a repository URL.
[user]
	name = TazLab Agent
	email = agent@tazlab.net
[credential]
	helper = "!f() { echo username=x-access-token; echo password=$(gopass show -o {{ paperclip_gopass_github_token }}); }; f"
[init]
	defaultBranch = master
[push]
	autoSetupRemote = true

#!/bin/bash
# Decrypt the agent's secrets into this process's environment, then exec.
#
# The identity comes from the environment (ADA_SECRETS_IDENTITY): on this LXC Proxmox
# injects it at container start, on a VM systemd would, on Docker -e. It is never
# written to a file: age reads it from a pipe. The encrypted secrets live in the home
# ({{ ada_home }}/.secrets/<NAME>.age), so a backup of the home is portable and useless
# without the identity. A file name IS the environment variable name.
set -eu
SECRETS="${ADA_SECRETS_DIR:-{{ ada_home }}/.secrets}"
IDENTITY="${ADA_SECRETS_IDENTITY:-}"

if [ -z "$IDENTITY" ] && [ -r "$SECRETS/identity" ]; then
	IDENTITY=$(grep -m1 '^AGE-SECRET-KEY' "$SECRETS/identity" 2>/dev/null || true)
fi
if [ -z "$IDENTITY" ]; then
	echo "ada-secrets: no identity (ADA_SECRETS_IDENTITY or $SECRETS/identity); starting without secrets" >&2
	exec "$@"
fi
export ADA_SECRETS_IDENTITY="$IDENTITY"

for file in "$SECRETS"/*.age; do
	[ -e "$file" ] || continue
	name=$(basename "$file" .age)
	case "$name" in
		*[!A-Za-z0-9_]*|[0-9]*)
			echo "ada-secrets: skipping '$name' (not a variable name)" >&2
			continue
			;;
	esac
	if value=$(printf '%s\n' "$IDENTITY" | age -d -i - "$file" 2>/dev/null); then
		export "$name=$value"
	else
		echo "ada-secrets: cannot decrypt $name" >&2
	fi
done

exec "$@"

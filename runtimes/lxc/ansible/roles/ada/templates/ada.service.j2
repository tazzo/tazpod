[Unit]
Description=Ada — the durable agent house
Documentation=file://{{ ada_app }}/README.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User={{ ada_user }}
Group={{ ada_group }}
WorkingDirectory={{ ada_app }}
EnvironmentFile=/etc/ada/env
# The identity is in PID 1's environment (Proxmox injects it via lxc.environment);
# systemd does not pass the manager's environment to units unless asked.
PassEnvironment=ADA_SECRETS_IDENTITY
ExecStart=/usr/local/bin/ada-secrets-exec /usr/bin/node src/main.ts serve
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
# The agent owns this container: it installs packages and runs commands here.
# The container boundary, not this unit, is the blast radius.

[Install]
WantedBy=multi-user.target

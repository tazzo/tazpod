#!/bin/bash
# Print one secret, decrypted on the fly. The identity comes from the environment
# (inherited from the engine), the ciphertext from the home. Nothing is written.
set -eu
name="${1:-}"
if [ -z "$name" ]; then
	echo "usage: ada-secret NAME" >&2
	exit 2
fi
SECRETS="${ADA_SECRETS_DIR:-{{ ada_home }}/.secrets}"
IDENTITY="${ADA_SECRETS_IDENTITY:-}"
if [ -z "$IDENTITY" ]; then
	echo "ada-secret: ADA_SECRETS_IDENTITY is not in the environment" >&2
	exit 1
fi
file="$SECRETS/$name.age"
[ -r "$file" ] || { echo "ada-secret: no such secret: $name" >&2; exit 1; }
printf '%s\n' "$IDENTITY" | age -d -i - "$file"

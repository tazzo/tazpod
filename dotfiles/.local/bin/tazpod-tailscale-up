#!/usr/bin/env bash
set -euo pipefail

HOSTNAME_ARG="${1:-$(hostname)}"
STATE_DIR="/var/lib/tailscale"
SOCKET_DIR="/var/run/tailscale"
SOCKET_PATH="${SOCKET_DIR}/tailscaled.sock"
STATE_PATH="${STATE_DIR}/tailscaled.state"
LOG_PATH="/tmp/tailscaled-hostnet.log"
# Pre-flight GPG / Gopass check
command -v gopass >/dev/null 2>&1 || { echo "❌ gopass not installed"; exit 1; }
gopass config core.autopush false >/dev/null 2>&1 || true
if ! timeout 3 gopass show bootstrap/tailscale/api-key >/dev/null 2>&1; then
  echo "[gopass] ❌ Gopass locked"
  exit 1
fi

resolve_secret() {
  local path="$1"
  gopass show "$path" 2>/dev/null | tr -d "'\"\t \r\n"
}

mint_authkey() {
  local api_key tailnet authkey

  # API key path is simpler and always available via vault
  api_key="$(resolve_secret "bootstrap/tailscale/api-key")"
  tailnet="$(resolve_secret "cluster/tailscale/tailnet")"
  if [[ -n "$api_key" && -n "$tailnet" ]]; then
    authkey="$(curl --silent --show-error --fail \
      --user "${api_key}:" \
      --header 'Content-Type: application/json' \
      --data '{"capabilities":{"devices":{"create":{"reusable":true,"ephemeral":true,"preauthorized":true,"tags":["tag:tazpod"]}}},"expirySeconds":3600,"description":"tazpod hostnet tun test"}' \
      "https://api.tailscale.com/api/v2/tailnet/${tailnet}/keys" | python3 -c 'import json,sys; print(json.load(sys.stdin)["key"])')"
    if [[ -n "$authkey" ]]; then
      printf '%s' "$authkey"
      return 0
    fi
  fi

  echo "Warning: Tailscale API key auth failed, trying OAuth fallback..." >&2
  local oauth_id oauth_secret token
  oauth_id="$(resolve_secret "bootstrap/tailscale/oauth-client-id")"
  oauth_secret="$(resolve_secret "bootstrap/tailscale/oauth-client-secret")"
  [[ -n "$oauth_id" && -n "$oauth_secret" ]] || { echo "No Tailscale auth material available." >&2; return 1; }

  token="$(curl --silent --show-error --fail \
    --request POST \
    --header 'Content-Type: application/x-www-form-urlencoded' \
    --data-urlencode "client_id=${oauth_id}" \
    --data-urlencode "client_secret=${oauth_secret}" \
    --data 'grant_type=client_credentials' \
    --data 'scope=auth_keys' \
    https://api.tailscale.com/api/v2/oauth/token 2>/dev/null | python3 -c 'import json,sys; print(json.load(sys.stdin).get("access_token", ""))')"
  [[ -n "$token" ]] || { echo "OAuth token failed." >&2; return 1; }

  authkey="$(curl --silent --show-error --fail \
    --request POST \
    --header "Authorization: Bearer ${token}" \
    --header 'Content-Type: application/json' \
    --data '{"capabilities":{"devices":{"create":{"reusable":true,"ephemeral":true,"preauthorized":true,"tags":["tag:tazpod"]}}},"expirySeconds":3600,"description":"tazpod hostnet tun test"}' \
    https://api.tailscale.com/api/v2/tailnet/-/keys | python3 -c 'import json,sys; print(json.load(sys.stdin).get("key", ""))')"
  printf '%s' "$authkey"
}

echo "tailscaled log: ${LOG_PATH}"
sudo mkdir -p "$STATE_DIR" "$SOCKET_DIR"

if ! pgrep -x tailscaled >/dev/null 2>&1; then
  sudo tailscaled --state="$STATE_PATH" --socket="$SOCKET_PATH" >"$LOG_PATH" 2>&1 &
  sleep 2
fi

AUTHKEY="$(mint_authkey)"
sudo tailscale --socket="$SOCKET_PATH" up --reset --authkey="$AUTHKEY" --hostname="$HOSTNAME_ARG" --ssh --accept-routes --accept-dns=false

echo "tailscale is up"
sudo tailscale --socket="$SOCKET_PATH" status

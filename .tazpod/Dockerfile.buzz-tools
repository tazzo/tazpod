# syntax=docker/dockerfile:1.7
#
# Buzz host tooling image — `buzz-acp`, `buzz` (crate buzz-cli) and `buzz-admin`,
# built from the PINNED Buzz revision (default: tag `relay-v0.2.1`, the same
# revision as the relay image the cluster runs).
#
# Why an image at all (DESIGN.md §A.2): the published relay image carries only
# `buzz-relay`, `buzz-admin` and `buzz-pair-relay`, and the GitHub releases are
# desktop installers. `buzz-acp` and `buzz-cli` are published nowhere. So an
# operator host cannot "download" them; they have to be built. Putting the build
# in an image means:
#   - no Rust toolchain is ever installed on the operator container (CT106),
#   - the artifact is content-addressed, so the digest pinned in this repo is
#     the pin, and the build is reproducible from the layer alone.
#
# The build context is a checkout of Buzz at the pinned revision (the workflow
# checks it out into ./buzz and passes `-f ../.tazpod/Dockerfile.buzz-tools`).

ARG RUST_VERSION=1.95
ARG DEBIAN_VERSION=bookworm
ARG BUZZ_REF=relay-v0.2.1

# ─── Stage 1: cargo-chef base ───────────────────────────────────────────────
FROM rust:${RUST_VERSION}-${DEBIAN_VERSION} AS chef
RUN cargo install cargo-chef --locked --version 0.1.71
WORKDIR /build

# ─── Stage 2: plan the dependency graph ─────────────────────────────────────
FROM chef AS planner
ARG BUZZ_REF
COPY . .
# Record the exact revision actually built, so the image states its own pin and
# a moving tag cannot silently change what the digest means.
RUN git rev-parse HEAD > /build/BUZZ_REVISION \
    && cargo chef prepare --recipe-path recipe.json

# ─── Stage 3: cook dependencies, build the three binaries ───────────────────
FROM chef AS builder
ARG BUZZ_REF
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        pkg-config \
        libssl-dev \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*
ENV CARGO_PROFILE_RELEASE_DEBUG=line-tables-only
COPY --from=planner /build/recipe.json recipe.json
# Cook the full workspace recipe: these crates depend on workspace siblings
# (buzz-sdk, buzz-core, buzz-db …), so scoping the recipe would re-build them.
RUN cargo chef cook --release --recipe-path recipe.json
COPY . .
# --locked: the pinned revision must build against its own Cargo.lock.
RUN cargo build --release --locked \
        -p buzz-acp    --bin buzz-acp \
        -p buzz-cli    --bin buzz \
        -p buzz-admin  --bin buzz-admin

# ─── Stage 4: runtime — three binaries, a manifest, and their checksums ──────
FROM debian:${DEBIAN_VERSION}-slim AS runtime
LABEL org.opencontainers.image.title="Buzz host tooling" \
      org.opencontainers.image.description="buzz-acp, buzz CLI and buzz-admin built from a pinned Buzz revision" \
      org.opencontainers.image.source="https://github.com/block/buzz"

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/target/release/buzz-acp   /usr/local/bin/buzz-acp
COPY --from=builder /build/target/release/buzz        /usr/local/bin/buzz
COPY --from=builder /build/target/release/buzz-admin  /usr/local/bin/buzz-admin
COPY --from=planner /build/BUZZ_REVISION             /usr/local/share/buzz/BUZZ_REVISION

# Checksums are generated INSIDE the image and verified by the Ansible layer on
# extraction, so a corrupted or truncated layer copy fails loudly instead of
# installing a half-written binary.
RUN cd /usr/local/bin \
    && sha256sum buzz-acp buzz buzz-admin > /usr/local/share/buzz/SHA256SUMS \
    && sha256sum -c /usr/local/share/buzz/SHA256SUMS

LABEL org.opencontainers.image.revision="${BUZZ_REF}"

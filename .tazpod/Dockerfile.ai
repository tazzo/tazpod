# --- TAZPOD LAYER 4: AI ENHANCED ---
# This layer depends on tazzo/tazpod-k8s
FROM tazzo/tazpod-k8s:latest

USER root

# Install Pi Coding Agent (Global npm)
RUN npm install -g @mariozechner/pi-coding-agent && \
    ln -sf $(npm config get prefix)/bin/pi /usr/local/bin/pi && \
    npm install -g @google/gemini-cli@latest

# Install oh-my-pi (Global installation for all users)
RUN curl -fsSL https://raw.githubusercontent.com/can1357/oh-my-pi/main/scripts/install.sh | sh && \
    mv /root/.local/bin/omp /usr/local/bin/omp && \
    chmod +x /usr/local/bin/omp

# Install pi-extmgr extension (as tazpod user to populate ~/.pi)
USER tazpod
WORKDIR /home/tazpod
RUN pi install npm:pi-extmgr

# Install Mnemosyne Dependencies
COPY --chown=tazpod:tazpod memory /home/tazpod/memory
RUN pip3 install --break-system-packages -r /home/tazpod/memory/requirements.txt

# Fix PATH and Banner
RUN sed -i '/LAYER ACTIVE/d' ~/.bashrc && \
    echo 'export PATH="/home/tazpod/.nvm/versions/node/$(ls /home/tazpod/.nvm/versions/node | head -1)/bin:$PATH"' >> ~/.bashrc && \
    echo 'echo -e "\n\033[1;35m🧠 TAZPOD AI POWERED LAYER ACTIVE (v0.2.3: Pi, oh-my-pi)\033[0m\n"' >> ~/.bashrc

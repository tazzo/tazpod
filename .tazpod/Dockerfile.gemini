# --- TAZPOD LAYER 4: AI ENHANCED ---
# This layer depends on tazzo/tazpod-k8s
FROM tazzo/tazpod-k8s:latest

USER root

# Install Gemini CLI (Correct Command)
RUN npm install -g @google/gemini-cli@latest

# Install OpenCode
RUN curl -fsSL https://opencode.ai/install | bash

USER tazpod
WORKDIR /home/tazpod

# Updated Banner for Gemini Layer
RUN sed -i '/LAYER ACTIVE/d' ~/.bashrc && \
    echo 'echo -e "\n\033[1;35m🧠 TAZPOD AI ENHANCED LAYER ACTIVE (Gemini Ready)\033[0m\n"' >> ~/.bashrc